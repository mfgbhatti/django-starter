# Copy to `.env` and edit. Never commit `.env`.

# WARNING: Never run production with debug on. True is for local dev only.
DEBUG=False

# WARNING: Required when DEBUG=False. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=

# NOTE: Comma separated. Empty means every host is rejected when DEBUG=False.
ALLOWED_HOSTS=localhost,127.0.0.1
# NOTE: Needed for HTTPS deployments, e.g. https://example.com
# CSRF_TRUSTED_ORIGINS=https://example.com

# NOTE: Login related urls (URL names or paths)
LOGIN_URL=accounts:login
LOGIN_REDIRECT_URL=/
LOGOUT_REDIRECT_URL=accounts:login

# NOTE: Sessions. SESSION_COOKIE_AGE is an idle timeout in seconds while
# SESSION_SAVE_EVERY_REQUEST is True (1500 = 25 minutes, the default).
SESSION_COOKIE_AGE=1500
SESSION_SAVE_EVERY_REQUEST=True
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# NOTE: HTTPS hardening. All default to ON when DEBUG=False.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=3600
# Behind nginx (and Cloudflare) SECURE_SSL_REDIRECT needs to know the original
# request was HTTPS, otherwise every request redirects to itself and browsers
# report a redirect loop / connection errors. Set True ONLY when nginx passes
# the original scheme to uwsgi as X-Forwarded-Proto (e.g.
# `uwsgi_param HTTP_X_FORWARDED_PROTO https;` for an HTTPS-only site) and does
# not forward a client-supplied value.
# BEHIND_PROXY=False

# Database file (relative to src/, or an absolute path). SQLite runs in WAL
# mode, so db.sqlite3-wal and db.sqlite3-shm appear next to it: back up all
# three together (or use `sqlite3 db.sqlite3 ".backup ..."`).
DATABASE_NAME=db.sqlite3

# Email backend (defaults to printing emails to the console).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
